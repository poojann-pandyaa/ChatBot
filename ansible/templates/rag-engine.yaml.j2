apiVersion: apps/v1
kind: Deployment
metadata:
  name: rag-engine
  namespace: {{ k8s_namespace }}
  labels:
    app: rag-engine
spec:
  replicas: 1
  selector:
    matchLabels:
      app: rag-engine
  template:
    metadata:
      labels:
        app: rag-engine
    spec:
      containers:
      - name: rag-engine
        image: {{ docker_registry }}/rag-engine:{{ image_tag }}
        imagePullPolicy: IfNotPresent
        env:
        - name: ML_SERVICE_GRPC_HOST
          value: "ml-service"
        - name: ML_SERVICE_GRPC_PORT
          value: "50051"
        - name: GRPC_SERVER_PORT
          value: "9091"
        - name: REDIS_HOST
          value: "redis"
        - name: REDIS_PORT
          value: "6379"
        - name: REDIS_PASSWORD
          valueFrom:
            secretKeyRef:
              name: llmops-secrets
              key: redis-password
        - name: QDRANT_URL
          value: "http://qdrant:6333"
        - name: ELASTICSEARCH_URL
          value: "http://elasticsearch:9200"
        - name: OLLAMA_URL
          value: "http://ollama:11434"
        - name: OLLAMA_MODEL
          value: "{{ ollama_model }}"
        - name: HF_HUB_OFFLINE
          value: "1"
        - name: HF_DATASETS_OFFLINE
          value: "1"
        - name: TRANSFORMERS_OFFLINE
          value: "1"
        - name: OMP_NUM_THREADS
          value: "1"
        - name: MKL_NUM_THREADS
          value: "1"
        ports:
        - containerPort: 8000
          name: http
        - containerPort: 9091
          name: grpc
        resources:
          requests:
            memory: "768Mi"
            cpu: "200m"
          limits:
            memory: "6Gi"
            cpu: "2000m"
        startupProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 30
        readinessProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 6
        livenessProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 15
          periodSeconds: 15
          timeoutSeconds: 5
          failureThreshold: 6
---
apiVersion: v1
kind: Service
metadata:
  name: rag-engine
  namespace: {{ k8s_namespace }}
  labels:
    app: rag-engine
spec:
  type: ClusterIP
  ports:
  - port: 8000
    targetPort: 8000
    name: http
  - port: 9091
    targetPort: 9091
    name: grpc
  selector:
    app: rag-engine
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: rag-engine-network-policy
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: rag-engine
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - podSelector:
        matchLabels:
          app: app-gateway
    ports:
    - protocol: TCP
      port: 9091
    - protocol: TCP
      port: 8000
  egress:
  - to:
    - podSelector:
        matchLabels:
          app: ml-service
    ports:
    - protocol: TCP
      port: 50051
  - to:
    - podSelector:
        matchLabels:
          app: ollama
    ports:
    - protocol: TCP
      port: 11434
  - to:
    - podSelector:
        matchLabels:
          app: qdrant
    ports:
    - protocol: TCP
      port: 6333
  - to:
    - podSelector:
        matchLabels:
          app: elasticsearch
    ports:
    - protocol: TCP
      port: 9200
  - to:
    - podSelector:
        matchLabels:
          app: redis
    ports:
    - protocol: TCP
      port: 6379
  - ports: # Allow DNS
    - protocol: UDP
      port: 53
    - protocol: TCP
      port: 53
