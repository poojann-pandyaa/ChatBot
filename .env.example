# ─────────────────────────────────────────────────────────────────────────────
# LLMOps Platform — Local Development Environment Variables
#
# Usage:
#   cp .env.example .env
#   Fill in real values in .env before running: docker compose -f docker-compose.dev.yml up
#
# NEVER commit .env to git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Redis password used by the redis-stack-server and all services
REDIS_PASSWORD=SuperSecureRedisPassword123

# Postgres primary password used by postgres and app-gateway
POSTGRES_PASSWORD=SuperSecurePostgresPassword123

# Postgres replication password used by bitnami postgres-replica
POSTGRES_REPLICATION_PASSWORD=SuperSecureReplicationPassword123
